{
  "name": "dsh-image-gen",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: generate images via Aliyun Bailian Qwen-Image (bl CLI). Saves a conversation attachment, writes the file to ~/.dsh/image-gen/ and auto-opens it in the system viewer.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-ui-attachment"
      ],
      "immediately": false
    }
  }
}
